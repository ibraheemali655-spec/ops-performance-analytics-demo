table SX_Measures
	lineageTag: 1527ea02-ed9d-441a-8fa7-1a4720ebb4b2

	measure 'Total Volume_SX' = CALCULATE(SUM('Appended'[Volume]), 'Appended'[Task Type] <> BLANK())
		formatString: #,0.00
		lineageTag: 90258daa-4508-4f97-89e8-d7423bfac804

	measure 'Vendor Capacity_SX' =
			VAR PrepTable =
			    FILTER(
			        SUMMARIZE(
			            'Appended',
			            'Appended'[vendor],
			            'Appended'[Date],
			            'Appended'[Task Type]
			        ),
			        NOT ISBLANK('Appended'[Task Type])
			    )
			VAR MonthlyVendorTaskVolume =
			    ADDCOLUMNS(
			        PrepTable,
			        "@MonthStart", DATE(YEAR('Appended'[Date]), MONTH('Appended'[Date]), 1),
			        "@TaskVolume", CALCULATE(SUM('Appended'[Volume]))
			    )
			VAR VendorTaskRates =
			    ADDCOLUMNS(
			        MonthlyVendorTaskVolume,
			        "@DailyCap",
			            IF(
			                [@MonthStart] >= DATE(2026, 9, 1),
			                SWITCH(
			                    'Appended'[Task Type],
			                    "Shooting", 1500,
			                    "Revision", 4000,
			                    "MTPE", 4000,
			                    "QA", 8000,
			                    "Translation", 3000,
			                    0
			                ),
			                SWITCH(
			                    'Appended'[Task Type],
			                    "Shooting", 1500,
			                    "Revision", 3000,
			                    "MTPE", 3000,
			                    "QA", 8000,
			                    "Translation", 2000,
			                    0
			                )
			            )
			    )
			VAR VendorTaskDays =
			    ADDCOLUMNS(
			        VendorTaskRates,
			        "@DaysSpent", IF([@DailyCap] > 0, [@TaskVolume] / [@DailyCap], 0)
			    )
			VAR MonthlyVendorSummary =
			    GROUPBY(
			        VendorTaskDays,
			        'Appended'[vendor],
			        [@MonthStart],
			        "@TotalVol", SUMX(CURRENTGROUP(), [@TaskVolume]),
			        "@TotalDays", SUMX(CURRENTGROUP(), [@DaysSpent])
			    )
			RETURN
			    SUMX(
			        MonthlyVendorSummary,
			        IF([@TotalDays] > 0, 22 * [@TotalVol] / [@TotalDays], 0)
			    )
		formatString: #,0
		lineageTag: b9bc045a-6bf0-4e29-a7cc-ee535dbccc9a

	measure 'Utilization_SX %' =
			
			DIVIDE([Total Volume_SX], [Vendor Capacity_SX])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1df8e673-6ba3-4c75-bc9d-bd7706b55b66

	measure 'Avg Monthly Volume_SX' =
			
			DIVIDE(
			    CALCULATE(SUM('Appended'[Volume]), 'Appended'[Task Type] <> BLANK()),
			    COUNTROWS(VALUES('Appended'[Date]))
			)
		formatString: #,0.00
		lineageTag: 058db3d9-dcb6-43da-923b-7e1baa9519d5

	column Column
		formatString: 0
		lineageTag: 604d9488-4f38-4622-801b-8d7b5703298d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition SX_Measures = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = c59db62699d44876b06cada8c955cb36

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

