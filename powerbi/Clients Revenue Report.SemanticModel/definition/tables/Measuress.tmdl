	measure 'MoM Detail' =
			VAR v = [Monthly Difference]
			VAR a = ABS ( v )
			VAR num = SWITCH ( TRUE (), a >= 1000000, FORMAT ( a / 1000000, "0.0" ) & "M", a >= 1000, FORMAT ( a / 1000, "0.0" ) & "K", FORMAT ( a, "0" ) )
			VAR pct = FORMAT ( DIVIDE ( v, [PreviousMonthRevenue] ), "+0.0%;-0.0%" )
			RETURN IF ( v >= 0, "▲ +$", "▼ -$" ) & num & IF ( pct = "", "", " · " & pct )
		displayFolder: 07 UI
		lineageTag: d1977cb8-ee6b-4661-964d-2c38dc2b1d14

	measure 'YoY Detail' =
			VAR v = [YearDifference]
			VAR a = ABS ( v )
			VAR num = SWITCH ( TRUE (), a >= 1000000, FORMAT ( a / 1000000, "0.0" ) & "M", a >= 1000, FORMAT ( a / 1000, "0.0" ) & "K", FORMAT ( a, "0" ) )
			VAR pct = FORMAT ( DIVIDE ( v, [PreviousYearRevenue] ), "+0.0%;-0.0%" )
			RETURN IF ( v >= 0, "▲ +$", "▼ -$" ) & num & IF ( pct = "", "", " · " & pct )
		displayFolder: 07 UI
		lineageTag: 1ef6832e-77c8-4297-80f9-d01afe307899

