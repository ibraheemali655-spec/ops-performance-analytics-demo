	measure 'Revenue Share %' = DIVIDE ( [TotalRevenue], CALCULATE ( [TotalRevenue], ALLSELECTED ( 'Jobs I' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Share
		lineageTag: 3205a8fa-1a66-4af6-888e-01d23525f58a

	measure 'Cumulative Revenue Share %' = ```
			
			VAR CurrentRev = [TotalRevenue]
			VAR HigherOrEqual =
			    FILTER ( ALLSELECTED ( 'Jobs I'[client_name] ), [TotalRevenue] >= CurrentRev )
			VAR CumRev = CALCULATE ( [TotalRevenue], HigherOrEqual )
			VAR Denom = CALCULATE ( [TotalRevenue], ALLSELECTED ( 'Jobs I'[client_name] ) )
			RETURN DIVIDE ( CumRev, Denom )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Share
		lineageTag: d4602128-5635-4aed-a7a8-b1a02ca7e566

	measure 'Growth Status YoY' = ```
			
			VAR Cur = [TotalRevenue]
			VAR Prior = [PreviousYearRevenue]
			RETURN
			SWITCH (
			    TRUE (),
			    ( Prior = 0 || ISBLANK ( Prior ) ) && Cur > 0, "New",
			    Cur = 0 && Prior > 0, "Lost",
			    Cur > Prior * 1.05, "Growing",
			    Cur < Prior * 0.95, "Declining",
			    "Stable"
			)
			
			```
		displayFolder: 05 Growth
		lineageTag: 1b150462-d8be-4e8d-b702-c07e2a767bd3

	measure 'Growth Status MoM' = ```
			
			VAR Cur = [TotalRevenue]
			VAR Prior = [PreviousMonthRevenue]
			RETURN
			SWITCH (
			    TRUE (),
			    ( Prior = 0 || ISBLANK ( Prior ) ) && Cur > 0, "New",
			    Cur = 0 && Prior > 0, "Lost",
			    Cur > Prior * 1.05, "Growing",
			    Cur < Prior * 0.95, "Declining",
			    "Stable"
			)
			
			```
		displayFolder: 05 Growth
		lineageTag: 476e9f65-bec5-49a8-9bf4-c653f72dc1a2

	measure 'Growth Color' = ```
			
			SWITCH ( [Growth Status YoY],
			    "Growing", "#3A7D44", "New", "#1A5C35",
			    "Declining", "#CD4040", "Lost", "#A83030",
			    "#5A5A5A"
			)
			
			```
		displayFolder: 05 Growth
		lineageTag: 6c004c7b-f61f-4676-8bbc-5cbe4276882c

