table Measuress
	lineageTag: 75aa0ec1-0c55-4cbf-ab66-dab37513edad

	measure TotalRevenue = ```
			
			SUMX(
			    SUMMARIZE(
			        'Jobs I',
			        'Jobs I'[project_id],
			        "RevenuePerProject", MAX('Jobs I'[project_total_agreed_e])
			    ),
			    [RevenuePerProject]
			)
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: afff89b5-ded6-4835-85a8-bb7e8be4e378

	measure 'TotalRevenue YoY%' = ```
			
			IF(
			    ISFILTERED('DateTable'[Date]),
			    ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
			    
			    VAR __PREV_YEAR = [PreviousYearRevenue]
			    VAR __CURR_YEAR = [TotalRevenue]
			    
			    RETURN
			        IF(
			            (ISBLANK(__CURR_YEAR) || __CURR_YEAR = 0) && (ISBLANK(__PREV_YEAR) || __PREV_YEAR = 0),
			            "-",  -- Return dash if both current and previous year are blank or zero
			            IF(
			                __PREV_YEAR = 0,
			                1,  -- Return 100% if previous year is 0 and current year is not zero
			                DIVIDE(__CURR_YEAR - __PREV_YEAR, __PREV_YEAR)
			            )
			        )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3601100b-1fb7-475f-9aed-b2414065f472

		extendedProperty MeasureTemplate =
