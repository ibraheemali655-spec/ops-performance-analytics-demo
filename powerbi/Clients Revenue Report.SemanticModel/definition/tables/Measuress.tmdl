	measure MoM% = ```
			
			VAR __PREV_MONTH = [PreviousMonthRevenue]
			VAR __CURR_MONTH = [TotalRevenue]
			
			RETURN
			    IF(
			        (ISBLANK(__CURR_MONTH) || __CURR_MONTH = 0) && (ISBLANK(__PREV_MONTH) || __PREV_MONTH = 0),
			        "-",  -- Return dash if both current and previous month are blank or zero
			        IF(
			            __PREV_MONTH = 0,
			            1,  -- Return 100% if previous month is 0 and current month is not zero
			            DIVIDE(__CURR_MONTH - __PREV_MONTH, __PREV_MONTH)
			        )
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cefbc72c-2072-4fa4-878e-6ae231683dda

	measure 'Monthly Difference' = [TotalRevenue] - [PreviousMonthRevenue]
		formatString: #,0.00
		lineageTag: eacbcb63-4ef5-4493-8eb6-427a410d3467

	measure RevenueChange = ```
			
			VAR __PREV_MONTH = CALCULATE([TotalRevenue], DATEADD(DateTable[Date], -1, MONTH))
			VAR __CURR_MONTH = [TotalRevenue]
			
			RETURN 
			    IF(
			        __CURR_MONTH < __PREV_MONTH,  -- Revenue dropped
			        __CURR_MONTH - __PREV_MONTH,  -- Return negative change
			        BLANK()  -- Ignore increases
			    )
			
			```
		formatString: "₪"#,0.###############;-"₪"#,0.###############;"₪"#,0.###############
		lineageTag: 66cdf055-f823-48b1-9575-b1bf091899f9

		annotation PBI_FormatHint = {"currencyCulture":"en-IL"}

