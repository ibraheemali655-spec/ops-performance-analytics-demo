	measure 'Growth Status Selected' = VAR b = [Selected Basis] VAR Cur = IF ( b = "YTD", [Revenue YTD], [TotalRevenue] ) VAR Prior = SWITCH ( b, "MoM", [PreviousMonthRevenue], "YoY", [PreviousYearRevenue], "YTD", [Revenue YTD PY], [PreviousYearRevenue] ) RETURN SWITCH ( TRUE ( ), ( Prior = 0 || ISBLANK ( Prior ) ) && Cur > 0, "New", ( Cur = 0 || ISBLANK ( Cur ) ) && Prior > 0, "Lost", Cur > Prior * 1.05, "Growing", Cur < Prior * 0.95, "Declining", "Stable" )
		displayFolder: 05 Growth
		lineageTag: 48c6addf-d0de-4278-8ad5-392a6e4464d5

	measure 'Growth Color Selected' = SWITCH ( [Growth Status Selected], "Growing", "#3A7D44", "New", "#1A5C35", "Declining", "#CD4040", "Lost", "#A83030", "#5A5A5A" )
		displayFolder: 05 Growth
		lineageTag: bb77b22d-ef9f-487b-8ab2-43aeaa7301d3

	measure 'Growth Status Matrix' = VAR Cur = [TotalRevenue] VAR AtMonthOrDeeper = ISINSCOPE ( 'Jobs I'[client_name] ) || ISINSCOPE ( 'Jobs I'[account] ) || ISINSCOPE ( 'LocalDateTable_7705dc45-5a53-4e5b-88d9-47a26f4584c3'[Month] ) VAR Prior = IF ( AtMonthOrDeeper, [PreviousMonthRevenue], [PreviousYearRevenue] ) RETURN SWITCH ( TRUE ( ), ( Prior = 0 || ISBLANK ( Prior ) ) && Cur > 0, "New", ( Cur = 0 || ISBLANK ( Cur ) ) && Prior > 0, "Lost", Cur > Prior * 1.05, "Growing", Cur < Prior * 0.95, "Declining", "Stable" )
		displayFolder: 05 Growth
		lineageTag: da9d003c-dee3-43c7-ad4e-33f716fb969e

	measure 'Growth Color Matrix' = SWITCH ( [Growth Status Matrix], "Growing", "#3A7D44", "New", "#1A5C35", "Declining", "#CD4040", "Lost", "#A83030", "#5A5A5A" )
		displayFolder: 05 Growth
