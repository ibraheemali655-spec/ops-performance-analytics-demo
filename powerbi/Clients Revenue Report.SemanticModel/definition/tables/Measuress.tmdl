	measure 'Growth Status YTD' =
			
			VAR Cur = [Revenue YTD]
			VAR Prior = [Revenue YTD PY]
			RETURN
			SWITCH (
			    TRUE (),
			    ( Prior = 0 || ISBLANK ( Prior ) ) && Cur > 0, "New",
			    Cur = 0 && Prior > 0, "Lost",
			    Cur > Prior * 1.05, "Growing",
			    Cur < Prior * 0.95, "Declining",
			    "Stable"
			)
		displayFolder: 05 Growth
		lineageTag: b67b5c36-2294-47ac-8eec-6daa1fc9eeee

