	measure 'Trend Revenue' = VAR SelYear = MAX ( 'DateTable'[Year] ) VAR y = SELECTEDVALUE ( 'TrendCal'[Year] ) VAR m = SELECTEDVALUE ( 'TrendCal'[Month Number] ) RETURN IF ( y >= SelYear - 2 && y <= SelYear, CALCULATE ( [TotalRevenue], REMOVEFILTERS ( 'DateTable' ), REMOVEFILTERS ( 'LocalDateTable_7705dc45-5a53-4e5b-88d9-47a26f4584c3' ), 'DateTable'[Year] = y, 'DateTable'[Month Number] = m ) )
