	column LanguageGroup = ```
			
			VAR Combo = 'Jobs I'[language_compination]
			RETURN
			    IF (
			        CONTAINSSTRING(Combo, "AR") && CONTAINSSTRING(Combo, "EN"),
			        "Arabic-English",
			        "Other"
			    )
			
			```
